# Default thesis provider is DeepSeek. The UI can switch to Claude per request
# if ANTHROPIC_API_KEY is also set. FINLENS_PROVIDER is only the default.
FINLENS_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...

# Optional: Claude. Only billed when the UI (or FINLENS_PROVIDER) selects it.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY is also accepted (Cursor / Claude Code). ANTHROPIC_API_KEY wins if both are set.
# Unscoped org keys also need: ANTHROPIC_WORKSPACE_ID=wrkspc_...
# FINLENS_CLAUDE_MODEL=claude-opus-5

# Optional overrides
# FINLENS_PASSWORD=           # HTTP Basic password for hosted deploys. Username is always `finlens`. Leave unset locally.
# FINLENS_DATA_DIR=/var/data  # Tradebook JSON root (persistent disk on Render)
# FINLENS_CACHE_DIR=/var/data/cache
# FINLENS_DEEPSEEK_MODEL=deepseek-v4-flash
# FINLENS_AI=off              # disable the AI layer entirely
# FINLENS_PRICE_TTL=900       # price cache, seconds
# FINLENS_FUND_TTL=86400      # fundamentals cache, seconds
# FINLENS_RISK_FREE_IN=0.068  # India 10Y G-Sec, used in the DCF discount rate
# FINLENS_ERP_IN=0.055        # equity risk premium
